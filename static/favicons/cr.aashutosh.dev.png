    <!--
      iOS launch images. Android composes its own splash from the manifest, and
      iOS shows a blank screen unless handed a picture matching the device
      exactly, which is why there is one line per phone. Generated by pnpm icons.
    -->
    <link
      rel="apple-touch-startup-image"
      media="(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)"
