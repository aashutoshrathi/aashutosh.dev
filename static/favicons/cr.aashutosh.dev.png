    <meta name="twitter:image" content="https://cr.aashutosh.dev/og.png" />
    <script type="module" crossorigin src="/assets/index-C2mHwwzE.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/index-BdwHCjKq.css">
  <link rel="manifest" href="/manifest.webmanifest"></head>
  <body>
    <div id="root"></div>
    <script>
      /*
       * Resolve the colour mode before first paint.
       *
       * The stylesheet keys light off data-theme so it only has to define the
       * light palette once. Without this, a light device would paint the dark
       * default for a frame before the app booted. Kept deliberately tiny and
       * failure tolerant: any problem here just leaves the dark default.
       */
      (function () {
        try {
          var saved = JSON.parse(localStorage.getItem('cr.prefs.v1') || '{}');
          var mode =
            saved.theme === 'dark' || saved.theme === 'light'
              ? saved.theme
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.setAttribute('data-theme', mode);
          document.documentElement.style.colorScheme = mode;
        } catch (e) {
          /* Storage blocked or unavailable. The dark default stands. */
        }
      })();
    </script>
  </body>
</html>
