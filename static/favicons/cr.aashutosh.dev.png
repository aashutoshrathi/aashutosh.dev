    <title>Chupa Rustam</title>
    <meta name="description" content="Everyone gets the word. One of you gets nothing. A free pass-the-phone party game." />
    <meta property="og:title" content="Chupa Rustam" />
    <meta property="og:description" content="Everyone gets the word. One of you gets nothing. A free pass-the-phone party game." />
